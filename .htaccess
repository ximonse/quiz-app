RewriteEngine On
RewriteBase /quiz-app/

# Block retired diagnostics even when old copies remain on the server.
RewriteRule ^test-(?:upload|error|stats)\.php(?:/.*)?$ - [G,L,NC]
# Keep data, locks and temporary files private. Only static raster uploads may
# be requested directly; PHP serves authorized materials through its endpoint.
RewriteRule ^data/(?!images/[^/]+\.(?:png|jpe?g|gif|webp)$) - [F,L,NC]

# Forward Bearer authentication to PHP on CGI/FastCGI hosting.
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Retired routes must stay unavailable even if an older SFTP upload remains.
RewriteRule ^(?:multi-quiz-(?:admin|edit|stats|student|variant)\.php|api/save-multi-progress\.php)(?:/.*)?$ - [G,L,NC]
ErrorDocument 410 "Den här äldre quizversionen har tagits bort. Använd vanliga faktaquiz eller glosquiz."

# Skydda data-mappen
<Files "data/*">
    Deny from all
</Files>
